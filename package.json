{
  "name": "x-post-fetcher",
  "version": "0.2.0",
  "private": true,
  "description": "X投稿取得 → 抽選情報 解析・DB登録システム（Phase 1: 保存層 + 生データ抽出）",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "login": "npm run login -w @x-post/scraper",
    "fetch": "npm run fetch -w @x-post/scraper",
    "scrape": "npm run scrape -w @x-post/scraper",
    "analyze": "npm run analyze -w @x-post/scraper",
    "worker:dev": "npm run dev -w @x-post/worker",
    "db:generate": "npm run db:generate -w @x-post/worker",
    "db:migrate": "npm run db:migrate -w @x-post/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  }
}
